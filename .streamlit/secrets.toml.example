# Copy to .streamlit/secrets.toml locally. Never commit the real file.
ADMIN_PASSWORD = "REPLACE_WITH_A_LONG_RANDOM_PASSWORD"
REGISTRATION_URL = "https://YOUR-APP.streamlit.app"

# For production: create Azure Storage Account + private container 'zen-event'
AZURE_STORAGE_CONNECTION_STRING = ""
AZURE_CONTAINER = "zen-event"
AZURE_BLOB_NAME = "college_fest_registrations.xlsx"
